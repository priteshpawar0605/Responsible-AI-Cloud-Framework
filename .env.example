# Environment variables for the Responsible AI Framework
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# API authentication key (change before deploying anywhere)
API_KEY=dev-insecure-key-change-me

# Configurable thresholds (optional — defaults are in config.py)
UNCERTAINTY_THRESHOLD=0.65
FAIRNESS_THRESHOLD=0.10
RISK_SCORE_HIGH=40
RISK_SCORE_MEDIUM=20

# Streamlit → API URL (used by app.py)
API_BASE_URL=http://localhost:8000

# Synthetic dataset size
SYNTHETIC_N_SAMPLES=2000
